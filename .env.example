# ====================================================
# Restaurant Portal - Environment Variables
# ====================================================

# --- Django Settings ---
DJANGO_SETTINGS_MODULE=restaurant_portal.settings.development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key-at-least-50-chars-long
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database Configuration ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=restaurant_portal
DB_USER=postgres
DB_PASSWORD=PostgreSQL
DB_HOST=localhost
DB_PORT=5432

# --- Email / SMTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# --- Redis Configuration ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT / Authentication ---
SIMPLE_JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS Settings ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True

# --- Payment Gateway (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Sentry (Optional) ---
SENTRY_DSN=

# --- Application Specific ---
APP_ENVIRONMENT=development
APP_NAME=Restaurant Portal
APP_VERSION=1.0.0